# DAYMARK OS Environment Configuration
# Copy this file to server/.env and fill in applicable credentials.
# If AI/Payment keys are absent, the application gracefully operates in high-fidelity Demo / Local fallback mode.

PORT=5050
NODE_ENV=development
JWT_SECRET=daymark_development_jwt_secret_change_me_in_production_min32chars
CORS_ORIGIN=http://localhost:3000

# Optional AI Providers (Adapter automatically activates when provided)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional Payment Providers (Test mode simulator active by default)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional Outbound Mail (Drafting and approval mode active by default)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DAYMARK Automation <notifications@daymark.io>"
